<Window x:Class="KeList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TodoList"
        Width="390"
        Height="520"
        MinWidth="320"
        MinHeight="380"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#D8171717"
        Foreground="#F2FFFFFF"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        SourceInitialized="Window_SourceInitialized"
        LocationChanged="Window_StateChanged"
        SizeChanged="Window_StateChanged"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryText" Color="#F2FFFFFF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#8FFFFFFF" />
        <SolidColorBrush x:Key="HoverBrush" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="ControlBrush" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#24FFFFFF" />

        <Style x:Key="TitleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Opacity" Value="0.58" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TodoCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="2,0,15,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="22" Height="22">
                            <Ellipse x:Name="Circle"
                                     Fill="Transparent"
                                     Stroke="#D9FFFFFF"
                                     StrokeThickness="1.5" />
                            <Path x:Name="Check"
                                  Data="M 5,11 L 9,15 L 17,7"
                                  Stroke="#F2FFFFFF"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="#20FFFFFF" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Stroke" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TodoTextStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#F2FFFFFF" />
        </Style>

        <Style x:Key="TodoRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinimalExpanderStyle" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderButton"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Stretch"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent" Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="Arrow"
                                                  Width="7"
                                                  Height="9"
                                                  Data="M 1,1 L 5,4.5 L 1,8"
                                                  Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5" />
                                            <ContentPresenter Grid.Column="1"
                                                              Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                              VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.9" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              Visibility="Collapsed"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Background="#A8171717"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="0,0,0,1"
                    Background="#08000000"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="23" Height="23" VerticalAlignment="Center">
                        <Rectangle RadiusX="4"
                                   RadiusY="4"
                                   Stroke="#D9FFFFFF"
                                   StrokeThickness="1.2" />
                        <Path Data="M 5,7 L 7,9 L 10,5.5 M 12,7.5 L 18,7.5 M 5,15 L 7,17 L 10,13.5 M 12,15.5 L 18,15.5"
                              Stroke="#D9FFFFFF"
                              StrokeThickness="1.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="11,0,8,0">
                        <TextBlock Text="TodoList"
                                   FontSize="17"
                                   FontWeight="Normal"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="for better"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryText}"
                                   Margin="7,3,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="PinButton"
                                Style="{StaticResource TitleButtonStyle}"
                                Click="PinButton_Click"
                                ToolTip="Keep above other windows">
                            <Path Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Stroke="#F2FFFFFF"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 8,2 L 14,8 L 11.5,9.5 L 10,13 L 7,10 L 3,14 M 5,5 L 11,11" />
                        </Button>

                        <Button x:Name="PassThroughButton"
                                Style="{StaticResource TitleButtonStyle}"
                                Click="PassThroughButton_Click"
                                ToolTip="Ignore mouse input (Ctrl + Alt + P)">
                            <Path Width="17"
                                  Height="17"
                                  Stretch="Uniform"
                                  Fill="Transparent"
                                  Stroke="#F2FFFFFF"
                                  StrokeThickness="1.3"
                                  StrokeLineJoin="Round"
                                  Data="M 3,2 L 14,10 L 9,11 L 7,16 Z" />
                        </Button>

                        <Button Style="{StaticResource TitleButtonStyle}"
                                Click="MoreButton_Click"
                                ToolTip="More">
                            <TextBlock Text="•••" FontSize="14" Margin="0,-5,0,0" />
                        </Button>

                        <Button Style="{StaticResource TitleButtonStyle}"
                                Click="HideButton_Click"
                                ToolTip="Hide to tray">
                            <Path Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Stroke="#F2FFFFFF"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  Data="M 2,2 L 12,12 M 12,2 L 2,12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14,12,14,4">
                <ListBox x:Name="ActiveList"
                         ItemsSource="{Binding ActiveItems}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource TodoRowStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="ActiveList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="ActiveList_PreviewMouseMove"
                         Drop="ActiveList_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="TodoRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                          Style="{StaticResource TodoCheckBoxStyle}"
                                          Click="CompletionCheckBox_Click" />

                                <TextBox Grid.Column="1"
                                         Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="{Binding DataContext.ItemFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Style="{StaticResource TodoTextStyle}"
                                         LostFocus="TodoText_LostFocus"
                                         KeyDown="TodoText_KeyDown" />

                                <TextBlock Grid.Column="2"
                                           x:Name="DragHandle"
                                           Text="⠿"
                                           FontSize="17"
                                           Foreground="{StaticResource SecondaryText}"
                                           Margin="8,0"
                                           VerticalAlignment="Center"
                                           Cursor="SizeAll"
                                           Opacity="0"
                                           ToolTip="Drag to reorder" />

                                <Button Grid.Column="3"
                                        x:Name="DeleteButton"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="DeleteButton_Click"
                                        ToolTip="Delete"
                                        Tag="{Binding}"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                    <Path Width="13"
                                          Height="15"
                                          Stretch="Uniform"
                                          Stroke="#BFFFFFFF"
                                          StrokeThickness="1.2"
                                          Data="M 3,5 L 3.8,14 L 11.2,14 L 12,5 M 2,4 L 13,4 M 5.5,4 L 6.3,2 L 9.7,2 L 10.5,4 M 6,7 L 6.5,12 M 9,7 L 8.5,12" />
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             Value="True">
                                    <Setter TargetName="DragHandle" Property="Opacity" Value="0.45" />
                                    <Setter TargetName="DeleteButton" Property="Opacity" Value="0.58" />
                                    <Setter TargetName="DeleteButton" Property="IsHitTestVisible" Value="True" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Expander x:Name="CompletedExpander"
                      Grid.Row="2"
                      Margin="18,4,18,8"
                      Style="{StaticResource MinimalExpanderStyle}"
                      Foreground="{StaticResource SecondaryText}">
                <Expander.Header>
                    <TextBlock>
                        <Run Text="Completed " />
                        <Run Text="{Binding CompletedCount, Mode=OneWay}" />
                    </TextBlock>
                </Expander.Header>
                <ListBox ItemsSource="{Binding CompletedItems}"
                         Margin="-6,6,-6,0"
                         MaxHeight="140"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource TodoRowStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Opacity="0.55">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                          Style="{StaticResource TodoCheckBoxStyle}"
                                          Click="CompletionCheckBox_Click" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Text}"
                                           FontSize="{Binding DataContext.ItemFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           TextWrapping="Wrap"
                                           TextDecorations="Strikethrough"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="2"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="DeleteButton_Click"
                                        ToolTip="Delete"
                                        Tag="{Binding}">
                                    <Path Width="13"
                                          Height="15"
                                          Stretch="Uniform"
                                          Stroke="#BFFFFFFF"
                                          StrokeThickness="1.2"
                                          Data="M 3,5 L 3.8,14 L 11.2,14 L 12,5 M 2,4 L 13,4 M 5.5,4 L 6.3,2 L 9.7,2 L 10.5,4" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Expander>

            <Grid Grid.Row="3" Margin="14,0,14,14">
                <Border Background="{StaticResource ControlBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="15,0">
                    <TextBox x:Name="NewTodoTextBox"
                             Height="52"
                             Background="Transparent"
                             Foreground="{StaticResource PrimaryText}"
                             BorderThickness="0"
                             FontSize="{Binding ItemFontSize}"
                             VerticalContentAlignment="Center"
                             CaretBrush="#F2FFFFFF"
                             TextChanged="NewTodoTextBox_TextChanged"
                             KeyDown="NewTodoTextBox_KeyDown" />
                </Border>

                <TextBlock x:Name="InputPlaceholder"
                           Text="What do you want to accomplish now?"
                           FontSize="{Binding ItemFontSize}"
                           Foreground="#70FFFFFF"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>

            <Border x:Name="UndoToast"
                    Grid.Row="3"
                    Margin="24,0,24,76"
                    Padding="12,8"
                    CornerRadius="8"
                    Background="#F02A2A2A"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Deleted" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                    <Button Content="Undo"
                            Margin="12,0,0,0"
                            Padding="7,2"
                            Foreground="{StaticResource PrimaryText}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="UndoButton_Click" />
                </StackPanel>
            </Border>

            <Border x:Name="StatusToast"
                    Grid.RowSpan="4"
                    Margin="22"
                    Padding="13,9"
                    CornerRadius="8"
                    Background="#F02A2A2A"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed">
                <TextBlock x:Name="StatusToastText"
                           Foreground="{StaticResource PrimaryText}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </Border>

            <Popup x:Name="MorePopup"
                   Placement="MousePoint"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Width="260"
                        Padding="14"
                        CornerRadius="10"
                        Background="#F5222222"
                        BorderBrush="#32FFFFFF"
                        BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="LockCheckBox"
                                  Content="Lock position and size"
                                  Foreground="{StaticResource PrimaryText}"
                                  Padding="4,5"
                                  Click="LockCheckBox_Click" />

                        <Border Height="1" Background="#18FFFFFF" Margin="0,9" />

                        <TextBlock Text="Font size"
                                   Foreground="{StaticResource SecondaryText}"
                                   Margin="4,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <Button Content="−"
                                    Style="{StaticResource TitleButtonStyle}"
                                    Click="DecreaseFontButton_Click" />
                            <TextBlock x:Name="FontSizeValue"
                                       Grid.Column="1"
                                       Text="{Binding ItemFontSize, StringFormat={}{0:0} px}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryText}" />
                            <Button Grid.Column="2"
                                    Content="+"
                                    Style="{StaticResource TitleButtonStyle}"
                                    Click="IncreaseFontButton_Click" />
                        </Grid>

                        <TextBlock Text="Background opacity"
                                   Foreground="{StaticResource SecondaryText}"
                                   Margin="4,12,0,4" />
                        <Slider x:Name="OpacitySlider"
                                Minimum="0.4"
                                Maximum="0.95"
                                SmallChange="0.05"
                                LargeChange="0.1"
                                ValueChanged="OpacitySlider_ValueChanged" />

                        <Border Height="1" Background="#18FFFFFF" Margin="0,12,0,8" />

                        <Button Content="About keList"
                                HorizontalContentAlignment="Left"
                                Foreground="{StaticResource PrimaryText}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4,7"
                                Cursor="Hand"
                                Click="AboutButton_Click" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
